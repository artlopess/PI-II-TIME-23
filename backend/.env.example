# PI-II-TIME-23 - Variáveis de ambiente do backend
#
# Copie este arquivo para ".env" dentro da pasta backend:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# O arquivo .env está no .gitignore e NUNCA deve ser enviado ao GitHub.
# A API e a rotina de seed usam o MESMO usuário. Para o seed funcionar, esse
# usuário precisa ter permissão para criar tabelas (CREATE TABLE). Se quiser,
# use um usuário administrador (como system) apenas durante os testes.

# Usuário dono das tabelas do sistema
DB_USUARIO=fluxo

# Senha desse usuário (substitua pela senha real do seu Oracle)
DB_SENHA=senha_aqui

# Endereço do Oracle no formato host:porta/nome_do_serviço
# Exemplos: localhost:1521/orclpdb | localhost:1521/XE
DB_CONEXAO=localhost:1521/orclpdb

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório).
# Obrigatório: a API não inicia sem ele e não existe valor padrão.
JWT_SEGREDO=troque_este_segredo_por_um_valor_aleatorio

# Origens autorizadas a chamar a API (CORS), separadas por vírgula.
# Inclua a porta que o Live Server mostrar na barra de status do VS Code.
# Se omitida, usa localhost/127.0.0.1 nas portas 3001 e 5500.
CORS_ORIGENS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5500,http://127.0.0.1:5500

